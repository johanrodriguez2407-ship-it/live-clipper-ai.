
import os
import uuid
import threading
import subprocess
from pathlib import Path
from urllib.parse import urlparse

import yt_dlp
from fastapi import FastAPI, HTTPException, Header, Depends
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, HttpUrl

app = FastAPI(title="LIVE CLIPPER AI")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

API_KEY = os.getenv("APP_API_KEY")
CLIPS_DIR = Path("/tmp/live-clipper-clips")
CLIPS_DIR.mkdir(parents=True, exist_ok=True)

jobs = {}
lock = threading.Lock()


def check_key(x_app_key: str = Header(default="")):
    if not API_KEY or x_app_key != API_KEY:
        raise HTTPException(status_code=401, detail="Acceso no autorizado")


class JobRequest(BaseModel):
    url: HttpUrl
    platform: str = "auto"
    duration: int = 60
    format: str = "vertical"


def capture(job_id, data):
    log_path = CLIPS_DIR / f"{job_id}.log"
    process = None

    try:
        with lock:
            jobs[job_id]["status"] = "connecting"

        options = {
            "quiet": True,
            "no_warnings": True,
            "noplaylist": True,
            "format": "best",
        }

        with yt_dlp.YoutubeDL(options) as ydl:
            info = ydl.extract_info(str(data.url), download=False)

        stream_url = info.get("url")
        if not stream_url:
            raise Exception("No se encontró una transmisión compatible.")

        output = str(CLIPS_DIR / f"{job_id}_%03d.mp4")

        command = [
            "ffmpeg", "-y",
            "-i", stream_url,
            "-map", "0",
            "-c", "copy",
            "-f", "segment",
            "-segment_time", str(data.duration),
            "-reset_timestamps", "1",
            "-segment_format", "mp4",
            output
        ]

        with open(log_path, "w") as log:
            process = subprocess.Popen(
                command,
                stdout=log,
                stderr=subprocess.STDOUT
            )

            with lock:
                jobs[job_id]["process"] = process
                jobs[job_id]["status"] = "recording"

            process.wait()

        with lock:
            if jobs[job_id]["status"] != "stopped":
                jobs[job_id]["status"] = (
                    "finished" if process.returncode == 0 else "error"
                )

    except Exception as error:
        with lock:
            jobs[job_id]["status"] = "error"
            jobs[job_id]["error"] = str(error)

    finally:
        with lock:
            if job_id in jobs:
                jobs[job_id]["process"] = None


@app.get("/health")
def health():
    return {"status": "LIVE CLIPPER AI online"}


@app.post("/api/jobs", dependencies=[Depends(check_key)])
def start_job(data: JobRequest):
    if data.duration not in [30, 60, 90]:
        raise HTTPException(400, "Duración no permitida")

    host = urlparse(str(data.url)).hostname or ""
    if not host:
        raise HTTPException(400, "Enlace no válido")

    job_id = str(uuid.uuid4())

    with lock:
        jobs[job_id] = {
            "id": job_id,
            "status": "starting",
            "url": str(data.url),
            "process": None,
        }

    thread = threading.Thread(
        target=capture,
        args=(job_id, data),
        daemon=True
    )
    thread.start()

    return {"id": job_id, "status": "starting"}


@app.post("/api/jobs/{job_id}/stop", dependencies=[Depends(check_key)])
def stop_job(job_id: str):
    with lock:
        job = jobs.get(job_id)
        if not job:
            raise HTTPException(404, "Captura no encontrada")

        process = job.get("process")
        job["status"] = "stopped"

    if process and process.poll() is None:
        process.terminate()

    return {"id": job_id, "status": "stopped"}


@app.get("/api/jobs/{job_id}", dependencies=[Depends(check_key)])
def get_job(job_id: str):
    with lock:
        job = jobs.get(job_id)
        if not job:
            raise HTTPException(404, "Captura no encontrada")

        return {
            "id": job["id"],
            "status": job["status"],
           "error": job.get("error")
        }
